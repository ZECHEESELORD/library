{
  "schemaVersion": 1,
  "id": "creative_library_movement_fabric_client",
  "version": "${version}",
  "name": "Creative Library Movement Fabric Client",
  "description": "Client side of the shared library's movement moves: runs the moves predictively on the local player, claims them to the server, reconciles verdicts, and drives camera cues.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "sh.harold.library.movement.fabric.client.MovementFabricClientInit"
    ]
  },
  "mixins": [
    "creative_library_movement_client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "fabric-api": ">=0.166.2",
    "creative_library_movement_fabric": "*",
    "creative_library_net_fabric_client": "*",
    "creative_library_camera_fabric_client": "*",
    "creative_library_telemetry_fabric_client": "*"
  }
}
